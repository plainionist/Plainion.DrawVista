<mxfile host="app.diagrams.net">
  <diagram id="page-layers" name="Layers">
    <mxGraphModel dx="800" dy="600" grid="1" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="foreground" value="Foreground" parent="0" />
        <mxCell id="hidden" value="Hidden" parent="0" visible="0" />
        <mxCell id="background-box" value="Background" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ff0000;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="foreground-box" value="Foreground" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0000ff;" vertex="1" parent="foreground">
          <mxGeometry x="80" y="60" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="outlier" value="HiddenOnly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#00ff00;gradientColor=#ffffff;" vertex="1" parent="hidden">
          <mxGeometry x="-240" y="-100" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="generated-link" value="Second" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="hidden">
          <mxGeometry x="260" y="180" width="100" height="40" as="geometry" />
        </mxCell>
        <UserObject id="external-link" label="Website" link="https://example.com/layers">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="hidden">
            <mxGeometry x="260" y="240" width="100" height="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-second" name="Second">
    <mxGraphModel dx="800" dy="600" grid="1" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="foreground" value="Foreground" parent="0" visible="0" />
        <mxCell id="hidden" value="Hidden" parent="0" />
        <mxCell id="second-background" value="Layers" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="second-foreground" value="SecondVisible" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="foreground">
          <mxGeometry x="80" y="60" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="second-hidden" value="SecondDefault" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="hidden">
          <mxGeometry x="-100" y="-80" width="120" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
