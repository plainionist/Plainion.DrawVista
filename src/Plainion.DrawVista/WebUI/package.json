{
  "name": "webui",
  "version": "0.0.1",
  "description": "Diagram Wiki",
  "productName": "Plainion.DrawVista",
  "author": "Friedemann Braune <friedemann.braune@gmail.comn>",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "node --test tests/*.test.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vue-tsc.json",
    "postinstall": "quasar prepare",
    "dev": "quasar dev",
    "build": "quasar build"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.20.0",
    "quasar": "^2.35.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.15",
    "vue-router": "^5.4.0",
    "vue-svg-pan-zoom": "^2.1.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@quasar/app-vite": "2.5.3",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.13.0 || ^24 || ^26 || ^28 || ^30",
    "pnpm": ">=11.0.0"
  }
}