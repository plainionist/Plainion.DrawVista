<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Rubjerg.Graphviz" Version="3.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <Target Name="VueBuild" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <!-- Quasar replaces hashed assets after MSBuild evaluates its default content glob. -->
    <ItemGroup>
      <Content Remove="wwwroot\**" />
    </ItemGroup>
    <Exec Command="pnpm build" WorkingDirectory="$(MSBuildProjectDirectory)\WebUI\" />
    <ItemGroup>
      <Content Include="wwwroot\**" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="VueCopyToOutput" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <WebUI Include="wwwroot\**" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUI)" DestinationFolder="$(OutputPath)\wwwroot\%(RecursiveDir)" />
  </Target>
</Project>